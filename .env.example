# ==========================================
# SurplusLink AI - Frontend Environment Config
# ==========================================

# Base URL pointing to the SurplusLink AI Python/Flask or Serverpod Backend
# When running backend locally: http://127.0.0.1:5000
VITE_API_BASE_URL=http://127.0.0.1:5000

# Smart Mock Fallback Mode (true = operates offline with realistic mock simulation; false = calls live backend)
# When set to true, requests fallback seamlessly if backend is unreachable.
VITE_USE_MOCK_DATA=true

# Mock AI extraction simulated delay (ms) for realistic UX demonstration
VITE_MOCK_DELAY_MS=600

# Default Rescue Session Join Code
VITE_DEFAULT_JOIN_CODE=RESCUE-7QK2
